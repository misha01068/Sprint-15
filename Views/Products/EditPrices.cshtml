@model List<ProductsValidation.Models.ProductPriceViewModel>

@{
    ViewData["Title"] = "Edit prices";
}

<h1>Edit prices: @ViewBag.Category</h1>

<form asp-action="EditPrices" method="post">
    <input type="hidden" name="category" value="@ViewBag.Category" />

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>
                        @Model[i].Id
                        <input type="hidden" asp-for="@Model[i].Id" />
                    </td>
                    <td>
                        @Model[i].Name
                        <input type="hidden" asp-for="@Model[i].Name" />
                    </td>
                    <td>
                        <input asp-for="@Model[i].Price" class="form-control" />
                        <span asp-validation-for="@Model[i].Price" class="text-danger"></span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <input type="submit" value="Save" class="btn btn-primary" />
</form>

<a asp-action="Index">Back to List</a>